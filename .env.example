# Copy to .env. Never commit .env or data/. Use long random values below.
POSTGRES_PASSWORD=replace-with-a-long-random-password
ZHIXU_SECRET_KEY=replace-with-a-separate-long-random-encryption-key
ZHIXU_COOKIE_SECURE=false
# Exact hosts of explicitly permitted internal model gateways, comma-separated.
ZHIXU_ALLOWED_PRIVATE_HOSTS=
ZHIXU_BIND_ADDRESS=127.0.0.1
ZHIXU_PORT=8080
